{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default iTestU desktop capabilities",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://www.itestu.uz/*",
      "https://itestu.uz/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "allow-desktop-resume"
  ]
}
