# Database
# Local dev (no Docker): SQLite
DATABASE_URL="file:./prisma/dev.db"
# Production / Docker: PostgreSQL
# DATABASE_URL="postgresql://ielts:ielts_dev@localhost:5432/ielts_mock_erp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Production (itestu.uz on VPS) — see deploy/env/api.env
# NODE_ENV=production
# CORS_ORIGIN="https://itestu.uz,https://www.itestu.uz"
# DATABASE_URL="postgresql://itestu:YOUR_PASSWORD@127.0.0.1:5432/itestu_erp?schema=public"

# Stripe (optional — mock mode when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS S3 (optional)
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# LiveKit — speaking exam video (https://cloud.livekit.io)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Set to "false" to disable server-side session recording
LIVEKIT_RECORDING_ENABLED="true"

# Public web app URL (used in password-reset emails)
APP_URL="http://localhost:3000"

# SMTP (required in production for password-reset emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="iTestU <noreply@itestu.uz>"
