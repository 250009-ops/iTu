# Database
# Local dev (no Docker): SQLite
DATABASE_URL="file:./prisma/dev.db"
# Production / Docker: PostgreSQL
# DATABASE_URL="postgresql://ielts:ielts_dev@localhost:5432/ielts_mock_erp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Stripe (optional — mock mode when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS S3 (optional)
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# LiveKit — speaking exam video (https://cloud.livekit.io)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Set to "false" to disable server-side session recording
LIVEKIT_RECORDING_ENABLED="true"
