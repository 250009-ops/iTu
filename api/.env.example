# ─── Database ───────────────────────────────────────────────────────────────
# Local dev (SQLite file — no Docker required):
DATABASE_URL="file:./prisma/dev.db"
# Docker / production (PostgreSQL):
# DATABASE_URL="postgresql://ielts:ielts_dev@localhost:5432/ielts_mock_erp?schema=public"

# ─── Redis (exam timers & session locks) ────────────────────────────────────
# Start with: docker compose up -d
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"
# Only this email can invite/manage admin team capabilities
MAIN_ADMIN_EMAIL="serkinov393@gmail.com"

# ─── Server ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Public web app URL (password-reset email links)
APP_URL="http://localhost:3000"

# ─── SMTP (Eskiz mail for itestu.uz — password reset & transactional email) ─
# 1. Eskiz panel → Pochta → Boshqarish paneli → create mailbox (e.g. noreply@itestu.uz)
# 2. SMTP host is usually mail.itestu.uz (or see Eskiz mail server settings)
# 3. Port 465 + SSL (SMTP_SECURE=true) per cPanel — or 587 + STARTTLS (SMTP_SECURE=false)
# 4. SMTP_USER = full email address; SMTP_PASS = mailbox password
# 5. Test: cd api && npm run mail:test your@email.com
SMTP_HOST="mail.itestu.uz"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@itestu.uz"
SMTP_PASS=""
SMTP_FROM="iTestU <noreply@itestu.uz>"
SMTP_REPLY_TO="support@itestu.uz"

# ─── LiveKit — speaking exam video (https://cloud.livekit.io) ─────────────
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_RECORDING_ENABLED="true"

# ─── Local media storage (Eskiz VPS — no AWS required) ─────────────────────
STORAGE_DRIVER=local
MEDIA_ROOT="./storage/media"
MEDIA_PUBLIC_URL="http://localhost:3001/media"
SERVE_MEDIA_LOCALLY="true"

# ─── Uzum Checkout (student + institution payments) ───────────────────────
# Register the callback URL in the Uzum merchant terminal:
#   https://<your-domain>/api/v1/payments/webhooks/uzum-checkout
UZUM_CHECKOUT_TERMINAL_ID=""
UZUM_CHECKOUT_API_KEY=""
# mTLS (production) — store PEM files outside git, e.g. deploy/secrets/ or VPS /var/www/itestu/secrets/
UZUM_CHECKOUT_CERT_PATH=""
UZUM_CHECKOUT_KEY_PATH=""
# SHA-256 hex digest of the client certificate (X-Signature header).
# Auto-computed from UZUM_CHECKOUT_CERT_PATH when omitted.
UZUM_CHECKOUT_SIGNATURE=""
# Test: https://test-chk-api.uzumcheckout.uz
# Production: confirm live URL with Uzum when going live
UZUM_CHECKOUT_BASE_URL="https://test-chk-api.uzumcheckout.uz"
UZUM_CHECKOUT_CONTENT_LANGUAGE="uz-UZ"
# Auto-fiscalization (IKPU from Uzum info letter)
UZUM_CHECKOUT_IKPU_SPIC="10899001001000000"
UZUM_CHECKOUT_PACKAGE_CODE="190309"
UZUM_CHECKOUT_VAT_PERCENT="0"
UZUM_CHECKOUT_MERCHANT_PINFL=""
UZUM_CHECKOUT_MERCHANT_TIN=""

# ─── Telegram onboarding bot (institution + student sign-up) ───────────────
# Create the bot via @BotFather, then register the webhook (note the api/v1 prefix):
#   curl -F "url=https://<api-host>/api/v1/integrations/telegram/webhook" \
#        -F "secret_token=<TELEGRAM_WEBHOOK_SECRET>" \
#        "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook"
# Student join links use: https://t.me/<TELEGRAM_BOT_USERNAME>?start=inst_<institutionId>
# ROTATE any token that has been shared in plaintext before go-live.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=""
# Local dev: Telegram cannot reach localhost via webhook, so the bot long-polls
# instead. Leave unset in dev (auto-on when NODE_ENV!=production). In production
# set TELEGRAM_POLLING="false" (default) to use the webhook.
TELEGRAM_POLLING=""
# Production only: public HTTPS host used to auto-register the webhook on boot.
# Defaults to APP_URL. The bot appends /api/v1/integrations/telegram/webhook.
TELEGRAM_WEBHOOK_BASE_URL=""
# Private channel for marketplace student mock feedback ONLY (reuse bot token).
# Does not replace onboarding DMs or applicant notify chats — those use explicit chat ids.
# Override per environment; falls back to this ID when unset.
TELEGRAM_FEEDBACK_CHANNEL_ID="-1004413242735"

# ─── Telegram admin tech-issues bot (separate BotFather token) ───────────
# Admins DM this bot, authenticate with platform ADMIN email/password, then
# submit issues (text + optional photos) that post to the tech-issues channel.
# Webhook (production): {TELEGRAM_WEBHOOK_BASE_URL}/api/v1/integrations/telegram-tech-issues/webhook
# ROTATE any token that has been shared in plaintext before go-live.
TELEGRAM_TECH_ISSUES_BOT_TOKEN=""
TELEGRAM_TECH_ISSUES_CHANNEL_ID="-1003941044424"
# Optional webhook secret (X-Telegram-Bot-Api-Secret-Token). Leave empty in local polling.
TELEGRAM_TECH_ISSUES_WEBHOOK_SECRET=""
# Optional override; falls back to TELEGRAM_POLLING / NODE_ENV like the onboarding bot.
# Use "true" only for local long-poll with a non-production token.
# "false" (or omit in production) keeps the public webhook. Never leave empty
# while sharing the production TELEGRAM_TECH_ISSUES_BOT_TOKEN — local polling
# calls deleteWebhook and stops Telegram from delivering updates to prod.
TELEGRAM_TECH_ISSUES_POLLING="false"

# ─── Stripe (legacy — not used for student checkout) ────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── AI features kill switch ─────────────────────────────────────────────
# Platform-wide AI (practice AI Writing, AI packs/tutor, examiner writing assist).
# Default when unset: disabled. Re-enable with AI_FEATURES_ENABLED=true.
AI_FEATURES_ENABLED=false

# ─── OpenAI — used only when AI_FEATURES_ENABLED=true ────────────────────
# Set your API key to enable inline essay highlights and suggested bands.
OPENAI_API_KEY=""
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# ─── Rate limiting (Phase G hardening) ─────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_TTL_MS=60000
CONTACT_RATE_LIMIT_MAX=5

# Swagger in production (default off; set true for debugging only)
# SWAGGER_ENABLED=false

# ─── Production templates ─────────────────────────────────────────────────
# See deploy/env/api.env.example for itestu.uz VPS values.
