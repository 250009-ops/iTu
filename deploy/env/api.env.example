# Production API environment — copy to server as api/.env
# Replace placeholders before going live.

NODE_ENV=production
PORT=3001
CORS_ORIGIN="https://itestu.uz,https://www.itestu.uz"

# PostgreSQL (required in production)
DATABASE_URL="postgresql://itestu:CHANGE_ME@127.0.0.1:5432/itestu_erp?schema=public"

# Redis (required for exam timers & distributed locks)
REDIS_URL="redis://127.0.0.1:6379"

# Auth
JWT_SECRET="CHANGE_ME-use-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"
# Only this email can invite/manage admin team capabilities
MAIN_ADMIN_EMAIL="serkinov393@gmail.com"

# Public web URL (password-reset links, emails)
APP_URL="https://www.itestu.uz"

# SMTP — Eskiz mail on itestu.uz (see api/.env.example for setup steps)
SMTP_HOST="mail.itestu.uz"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@itestu.uz"
SMTP_PASS="CHANGE_ME-mailbox-password"
SMTP_FROM="iTestU <noreply@itestu.uz>"
SMTP_REPLY_TO="support@itestu.uz"

# LiveKit — speaking video (https://cloud.livekit.io)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_RECORDING_ENABLED="true"

# Local media on VPS disk (nginx serves /media/)
STORAGE_DRIVER=local
MEDIA_ROOT="/var/www/itestu/media"
MEDIA_PUBLIC_URL="https://www.itestu.uz/media"
SERVE_MEDIA_LOCALLY="false"

# Uzum Checkout — student + institution payments
# Callback URL (register in Uzum merchant terminal):
#   https://itestu.uz/api/v1/payments/webhooks/uzum-checkout
UZUM_CHECKOUT_TERMINAL_ID=""
UZUM_CHECKOUT_API_KEY=""
# mTLS PEM files on VPS only (see deploy/secrets/README.md) — never commit real certs
UZUM_CHECKOUT_CERT_PATH="/var/www/itestu/secrets/uzum-client.crt"
UZUM_CHECKOUT_KEY_PATH="/var/www/itestu/secrets/uzum-client.key"
UZUM_CHECKOUT_SIGNATURE=""
UZUM_CHECKOUT_BASE_URL="https://test-chk-api.uzumcheckout.uz"
UZUM_CHECKOUT_CONTENT_LANGUAGE="uz-UZ"

# Stripe — legacy (not used for student checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Rate limiting (Phase G)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_TTL_MS=60000
CONTACT_RATE_LIMIT_MAX=5

# AI features kill switch (practice AI + examiner writing assist). Default off.
AI_FEATURES_ENABLED=false
# OpenAI — used only when AI_FEATURES_ENABLED=true
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Telegram — onboarding bot + marketplace mock feedback channel
# Token/username usually already set on the VPS; channel can override per env.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_POLLING="false"
TELEGRAM_WEBHOOK_BASE_URL="https://itestu.uz"
# Private channel where system-student mock feedback is posted.
# Mock feedback channel only — never a default for onboarding/applicant DMs.
TELEGRAM_FEEDBACK_CHANNEL_ID="-1004413242735"

# Admin tech-issues bot (separate token from onboarding bot)
TELEGRAM_TECH_ISSUES_BOT_TOKEN=""
TELEGRAM_TECH_ISSUES_CHANNEL_ID="-1003941044424"
TELEGRAM_TECH_ISSUES_WEBHOOK_SECRET=""
# Keep "false" when the bot token is the production one. Local "true"/implicit
# polling calls deleteWebhook and stops Telegram delivering to prod.
TELEGRAM_TECH_ISSUES_POLLING="false"
